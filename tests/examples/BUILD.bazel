cc_test(
    name = "test_audio_element_types",
    srcs = ["test_audio_element_types.c"],
    deps = [
        "//:oar",
    ],
)

cc_test(
    name = "test_channel_based_rendering",
    srcs = ["test_channel_based_rendering.c"],
    deps = [
        "//:oar",
    ],
)

# Exercises the 120 Hz LFE low-pass, which is only compiled into the library
# when the LFE path is enabled. Build with `--define OAR_ENABLE_HOA_LFE=1`;
# without it this target is skipped rather than built or run, so it breaks
# neither `bazel build //...` nor `bazel test //tests/examples/...`.
cc_test(
    name = "test_hoa_lfe_rendering",
    srcs = ["test_hoa_lfe_rendering.c"],
    target_compatible_with = select({
        "//src:enable_hoa_lfe": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//:oar",
    ],
)

cc_test(
