load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = [
        "//src:__subpackages__",
    ]
)

# The CMake options mirrored below accept boolean constants in several
# spellings (ON/OFF, TRUE/FALSE, YES/NO), and `--define` silently ignores
# values with no matching config_setting, so recognize the common spellings
# rather than just "1"/"0".
ENABLED_SPELLINGS = [
    "1",
    "ON",
    "On",
    "on",
    "TRUE",
    "True",
    "true",
    "YES",
    "Yes",
    "yes",
]

DISABLED_SPELLINGS = [
    "0",
    "OFF",
    "Off",
    "off",
    "FALSE",
    "False",
    "false",
    "NO",
    "No",
    "no",
]

# Build with the flag `--define OAR_ENABLE_BINAURALIZER=0` to disable
# binaural rendering.
[
    config_setting(
        name = "_binauralizer_" + value,
        define_values = {
            "OAR_ENABLE_BINAURALIZER": value,
        },
    )
    for value in DISABLED_SPELLINGS
]

selects.config_setting_group(
    name = "disable_binauralizer",
    match_any = [":_binauralizer_" + value for value in DISABLED_SPELLINGS],
)

# Build with the flag `--define OAR_ENABLE_HOA_LFE=1` to generate the LFE
# channel when rendering HOA to loudspeakers. Mirrors the CMake option of the
# same name, which is likewise off by default.
[
    config_setting(
        name = "_hoa_lfe_" + value,
        define_values = {
            "OAR_ENABLE_HOA_LFE": value,
        },
    )
    for value in ENABLED_SPELLINGS
]

selects.config_setting_group(
    name = "enable_hoa_lfe",
    match_any = [":_hoa_lfe_" + value for value in ENABLED_SPELLINGS],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "oar_config",
    hdrs = ["oar_config.h"],
    strip_include_prefix = "//src",
    deps = [
        "//src/common",
    ]
)

cc_library(
    name = "oar",
    srcs = [
        "oar.c",
    ],
    strip_include_prefix = "//src",
    # Defines `__binauralizer__` by default.
    defines = select({
        ":disable_binauralizer": [],
        "//conditions:default": ["__binauralizer__"],
    }),
    # Depends on obr by default.
    deps = [
        ":oar_utils",
        "//include",
        "//src/common",
        "//src/limiter:oar_limiter",
        "//src/renderer:audio_element_renderer",
        "//src/renderer:audio_elements_renderer",
        "//src/renderer:audio_renderer_base",
        "//src/renderer:renderer_library_api",
        "//src/renderer:renderer_library_manager",
        "//src/renderer/downmix",
        "//src/renderer/ear",
        "//src/renderer/olr",
        "//src/utility",
    ] + select({
        ":disable_binauralizer": [],
        "//conditions:default": ["//src/renderer/obr"],
    }),
    visibility = ["//:__pkg__"],
    alwayslink = True,
)

cc_library(
    name = "oar_utils",
    srcs = [
        "oar_utils.c",
    ],
    hdrs = ["oar_utils.h"],
    strip_include_prefix = "//src",
    deps = [
        "//include",
        "//src/common",
        "//src/renderer:renderer_library_api",
    ],
)
